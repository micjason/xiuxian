; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="修仙"
config/version="0.16.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="xiuxian"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/ui/app_icon.svg"
boot_splash/bg_color=Color(0.0352941, 0.0470588, 0.054902, 1)
boot_splash/image="res://assets/art/ui/splash_1080x1920.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[autoload]

AppEnv="*res://autoload/app_env.gd"
ApiClient="*res://autoload/api_client.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2340
window/size/window_width_override=540
window/size/window_height_override=1170
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/xiuxian_android_updater/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.055, 1)

[xiuxian]

build/version_code=37

network/api_base_url="http://127.0.0.1:8080"
