extends SceneTree
## MOCK screenshot harness; fixture is generated by the real TypeScript simulateBattle.
var out := "/workspace/cp_fix_shots/combat_system"
var scene: Node

func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	if not args.is_empty():
		out = args[0]
	DirAccess.make_dir_recursive_absolute(out)
	scene = load("res://scenes/main.tscn").instantiate()
	root.add_child(scene)
	for i in 20:
		await process_frame
	for key in ["_offline_popup", "_announcement", "_login"]:
		var overlay := scene.get(key) as Control
		if overlay != null:
			overlay.hide()
	var session: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://fixtures/combat_timeline.json"))
	var page: TimelineBattlePage = scene.get("_battle_page")
	# Stage uses the identical page, differing only in source/target and rewards.
	scene.call("_open_battle", "lianqi_3")
	session["source"] = "stage"
	session["target"] = {"source": "stage", "stageSlug": "lianqi_3"}
	page.open_session(session, scene.get("_state"), scene.get("_content"))
	page.call("_set_speed", 1.0)
	await _until(page, 2.0)
	await _shot("01_stage_skill_crit.png")
	page.call("_set_speed", 2.0)
	await _until(page, 5.6)
	await _shot("02_stage_auto_rage_x2.png")
	page.abort()
	session["source"] = "fog"
	session["target"] = {"source": "fog", "mapId": "fog_wenxin_valley", "objectId": "m_guard"}
	scene.call("_on_fog_battle", session)
	page.call("_set_speed", 3.0)
	await _until(page, 3.7)
	await _shot("03_fog_same_page_skip_x3.png")
	print("COMBAT_CAPTURE_DONE ", out)
	page.abort()
	scene.queue_free()
	for i in 4:
		await process_frame
	quit()

func _until(page: TimelineBattlePage, clock: float) -> void:
	var frames := 0
	while page._clock < clock and frames < 3000:
		await process_frame
		frames += 1
	for i in 5:
		await process_frame

func _shot(name: String) -> void:
	await process_frame
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png(out.path_join(name))
	print("COMBAT_SHOT ", name)
